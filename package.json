{
  "name": "mypen",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install && ./scripts/apply-firebase-configs.sh",
    "apply:firebase": "./scripts/apply-firebase-configs.sh",
    "web": "echo 'web disabled — out of scope for MVP' && exit 0",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "test:e2e:build": "detox build",
    "functions:serve": "cd functions && pnpm run serve",
    "functions:deploy": "cd functions && pnpm run deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.3.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/flash-list": "1.7.1",
    "@tanstack/react-query": "^5.59.0",
    "date-fns": "^4.1.0",
    "expo": "~51.0.39",
    "expo-constants": "~16.0.2",
    "expo-image-picker": "~15.0.7",
    "expo-notifications": "~0.28.19",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "firebase": "^10.14.1",
    "lucide-react-native": "^0.453.0",
    "react": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.74.5",
    "react-native-calendars": "^1.1306.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^25.9.1",
    "@types/react": "~18.2.79",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "babel-preset-expo": "~11.0.15",
    "eas-cli": "^20.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
