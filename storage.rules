rules_version = '2';

// MyPen — Cloud Storage security rules
//
// Object layout:
//   users/{uid}/{kind}/{id}/photo.jpg   — pen / ink / avatar photos
//
// Rule: a user can read any photo (so the in-app share/screenshot
// flows can resolve without auth) and can write only their own.
// Auth is required for any read OR write; the broader "public read"
// path is left for a future "share my collection" feature.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
