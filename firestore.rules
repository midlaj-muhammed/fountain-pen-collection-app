rules_version = '2';

// MyPen — Firestore security rules
//
// Data layout:
//   users/{uid}                       — user profile + settings
//   users/{uid}/pens/{penId}          — pens
//   users/{uid}/inks/{inkId}          — inks
//   users/{uid}/sessions/{sessionId}  — writing sessions
//   users/{uid}/pens/{penId}/nibSwaps/{swapId}  — nib swap history
//
// Rule: a user can read/write ONLY their own subtrees. No
// unauthenticated access. No cross-tenant access. No admin SDK
// in the client.

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny — every path not explicitly matched falls through
    // to this. Anything we forget to allow stays closed.
    match /{document=**} {
      allow read, write: if false;
    }

    // Per-user top-level profile + settings.
    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // The user's own subcollections. Same rule, applied to the
    // sub-paths (pens, inks, sessions, etc.) and to nested
    // sub-paths (nibSwaps under a pen).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
